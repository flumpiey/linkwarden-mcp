{
  "manifest_version": "0.4",
  "name": "linkwarden-mcp",
  "display_name": "Linkwarden MCP",
  "version": "0.1.5",
  "description": "MCP server for Linkwarden bookmarks: read-first search and preserved content, with opt-in write, delete, and collection-delete tools. Requires uv on PATH.",
  "author": {
    "name": "flumpiey",
    "url": "https://github.com/flumpiey/linkwarden-mcp"
  },
  "homepage": "https://github.com/flumpiey/linkwarden-mcp",
  "documentation": "https://github.com/flumpiey/linkwarden-mcp#readme",
  "support": "https://github.com/flumpiey/linkwarden-mcp/issues",
  "icon": "icon.png",
  "server": {
    "type": "uv",
    "entry_point": "server/main.py",
    "mcp_config": {
      "command": "uv",
      "args": ["tool", "run", "--python", "3.12", "linkwarden-mcp"],
      "env": {
        "LINKWARDEN_API_URL": "${user_config.api_url}",
        "LINKWARDEN_API_KEY": "${user_config.api_key}",
        "LINKWARDEN_MCP_WRITE_SCOPES": "${user_config.write_scopes}",
        "LINKWARDEN_MCP_DELETE_SCOPES": "${user_config.delete_scopes}"
      }
    }
  },
  "user_config": {
    "api_url": {
      "type": "string",
      "title": "Linkwarden API URL",
      "description": "Instance base URL without /api/v1 (e.g. http://127.0.0.1:3000).",
      "required": true,
      "default": "http://127.0.0.1:3000"
    },
    "api_key": {
      "type": "string",
      "title": "Linkwarden API key",
      "description": "Access token from Linkwarden settings.",
      "sensitive": true,
      "required": true
    },
    "write_scopes": {
      "type": "string",
      "title": "Write scopes",
      "description": "Comma-separated domains for create/update: links,collections,tags,raw. Recommended: links,collections. Leave empty for read-only.",
      "required": false,
      "default": ""
    },
    "delete_scopes": {
      "type": "string",
      "title": "Delete scopes",
      "description": "Comma-separated domains for delete only. Never implied by write scopes. Leave empty for no deletes.",
      "required": false,
      "default": ""
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"]
  }
}
