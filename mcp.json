{
  "mcpServers": {
    "linkwarden": {
      "command": "uvx",
      "args": ["linkwarden-mcp"],
      "env": {
        "LINKWARDEN_API_URL": "${LINKWARDEN_API_URL}",
        "LINKWARDEN_API_KEY": "${LINKWARDEN_API_KEY}",
        "LINKWARDEN_MCP_WRITE_SCOPES": "${LINKWARDEN_MCP_WRITE_SCOPES}",
        "LINKWARDEN_MCP_DELETE_SCOPES": "${LINKWARDEN_MCP_DELETE_SCOPES}"
      }
    }
  }
}
