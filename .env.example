# Linkwarden instance (base URL; include /api/v1 if your deployment requires it)
# Typical self-host / Docker: http://127.0.0.1:3000 (no /api/v1 — client paths add it)
LINKWARDEN_API_URL=https://links.example.com
# Settings → Access Tokens → New Access Token (or /settings/access-tokens)
LINKWARDEN_API_KEY=your-access-token-here

# Integration tests (pytest -m integration) use a separate sandbox instance:
TEST_LINKWARDEN_API_URL=https://links.example.com
TEST_LINKWARDEN_API_KEY=your-test-access-token-here

# Scoped writes (comma-separated; no wildcards). Empty = read-only.
# Valid: links,collections,tags,raw
# MCP host env (e.g. .cursor/mcp.json or Cursor plugin Configure) MUST match
# these or behavior drifts.
#
# Recommended narrow bookmark workflow:
# LINKWARDEN_MCP_WRITE_SCOPES=links,collections
# LINKWARDEN_MCP_DELETE_SCOPES=links
#
# All domain scopes (discouraged; registers every mutating tool):
# LINKWARDEN_MCP_WRITE_SCOPES=links,collections,tags
# LINKWARDEN_MCP_DELETE_SCOPES=links,collections,tags
#
# raw expands effective write scopes to all domain scopes (escape hatch).
#
# Legacy LINKWARDEN_MCP_ALLOW_WRITES / ALLOW_WRITES / LINKWARDEN_MCP_WRITES
# hard-fail if any are set (non-empty).
#
# Optional bulk cap (default 25):
# LINKWARDEN_MAX_BULK=25
